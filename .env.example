# ---------------------------------------------------------------------------
# AI Life Manager — environment variables
#
# Copy the values you need into your hosting provider's dashboard (Vercel:
# Project → Settings → Environment Variables) or into a local `.env` file.
# NEVER commit real values. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# --- Gemini (the AI assistant) ---------------------------------------------
# Server-side only: this key is never sent to the browser.
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides.
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_TIMEOUT_MS=15000
# GEMINI_MAX_RETRIES=2

# Set to "false" to disable the built-in reminder parser. The parser is the
# deterministic fallback used when Gemini is unavailable, so leaving it enabled
# is recommended.
# AI_OFFLINE_FALLBACK=true

# --- Storage ---------------------------------------------------------------
# Local Node server only (`npm start`). On Vercel the filesystem is read-only,
# so use Turso (libSQL) there.
# DATABASE_PATH=./data/app.sqlite

# Turso / libSQL over HTTP (recommended on Vercel).
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=

# --- Runtime ---------------------------------------------------------------
# NODE_ENV=production
# APP_ORIGIN=https://your-project.vercel.app
# SESSION_TTL_MS=604800000
# TRUST_PROXY=true
